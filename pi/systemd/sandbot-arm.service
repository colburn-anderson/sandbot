[Unit]
Description=Sandbot - Freenove Arm Server
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
WorkingDirectory=/home/tallergiraffe/Freenove_Robot_Arm_Kit_for_Raspberry_Pi/Server/Code
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target