[Unit]
Description=SandBot Bridge Server
After=sandbot-arm.service
Requires=sandbot-arm.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/tallergiraffe/sandbot
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/tallergiraffe/sandbot/sandbot_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
